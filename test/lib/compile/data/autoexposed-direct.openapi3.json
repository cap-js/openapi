                "$ref": "#/components/schemas/MyService.ScanStates"
              }
            ],
            "nullable": true
          }
        }
      },
      "MyService.Orders-create": {
        "title": "Orders (for create)",
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "ID"
        ]
      },
      "MyService.Orders-update": {
