{
  "name": "@cap-js/openapi",
  "version": "1.6.0",
  "description": "CAP tool for OpenAPI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cap-js/openapi.git"
  },
  "homepage": "https://cap.cloud.sap/",
  "keywords": [
    "CAP",
    "CDS",
    "OpenAPI",
    "Node.js"
  ],
  "author": "SAP SE (https://www.sap.com)",
  "license": "Apache-2.0",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cds-plugin": "./cds-plugin.js"
  },
  "files": [
    "lib/",
    "index.js",
    "cds-plugin.js",
    "LICENSE"
  ],
  "cds": {
    "schema": {
      "export": {
        "openapi": {
          "type": "object",
          "description": "OpenAPI settings for cds compile",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "description": "Service root URL"
            },
            "servers": {
              "type": "array",
              "description": "OpenAPI servers array"
            },
            "odataVersion": {
              "type": "string",
              "description": "OData version (e.g. '4.01', '4.0')"
            },
            "scheme": {
              "type": "string",
              "description": "URL scheme when url is not set",
              "default": "https"
            },
            "host": {
              "type": "string",
              "description": "Host when url is not set",
              "default": "localhost"
            },
            "basePath": {
              "type": "string",
              "description": "Base path when url is not set",
              "default": "/service-root"
            },
            "diagram": {
              "type": "boolean",
              "description": "Include ER diagram in description",
              "default": false
            },
            "maxLevels": {
              "type": "integer",
              "description": "Maximum navigation expansion depth",
              "default": 5
            },
            "shortActionPaths": {
              "type": "boolean",
              "description": "Use simplified action path names",
              "default": false
            },
            "defaultProtocol": {
              "type": "string",
              "description": "Default protocol for services without @protocol annotation",
              "default": "odata"
            }
          }
        }
      },
      "importFrom": {
        "const": "openapi",
        "description": "OpenAPI specification"
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "lint": "npx eslint .",
    "check:types": "npx tsc",
    "gen:coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info",
    "regenerate": "node scripts/regenerate.js"
  },
  "dependencies": {
    "pluralize": "^8.0.0"
  },
  "peerDependencies": {
    "@sap/cds": ">=7.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "typescript": "^7.0.2"
  }
}
